+fn skip_wide_morph_table(buffer: &mut Bytes, has_default: bool) -> Result<(), ReadError> {
+    buffer.try_get_u8()?;
+    buffer.try_get_u16()?;
+    buffer.try_get_u16()?;
+    if has_default {
+        buffer.try_get_smart32()?;
+    }
+    let count = buffer.try_get_unsigned_smart()? as usize;
+    for _ in 0..=count {
+        buffer.try_get_smart32()?;
+    }
+    Ok(())
+}
